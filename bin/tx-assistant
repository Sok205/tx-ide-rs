#!/usr/bin/env bash
# tx-assistant — forward one line of input to the tx-assistant session.
# Bound to prefix+/ via tmux/tx-ide.tmux.
#   --from-buffer   input is the tx-assistant-input tmux paste buffer
#                   (set by the prefix+/ binding to avoid shell-escaping
#                   the command-prompt value)
#   --warm          ensure the session exists (and send priming if freshly
#                   created) without forwarding any input — used by `tx start`
set -u

buffer=tx-assistant-input
warm_only=0
case "${1:-}" in
--from-buffer)
  input=$(tmux show-buffer -b "$buffer" 2>/dev/null) || input=""
  tmux delete-buffer -b "$buffer" 2>/dev/null || true
  ;;
--warm)
  warm_only=1
  input=""
  ;;
*)
  printf 'tx-assistant: unknown invocation; pass --warm or --from-buffer\n' >&2
  exit 2
  ;;
esac

if [ "$warm_only" -eq 0 ]; then
  [ -z "${input// /}" ] && exit 0
fi

session=tx-assistant
priming='Read ~/.tx-ide/agents/COMMON.md and ~/.tx-ide/agents/TX-ASSISTANT.md as your first actions. Then, if they exist, also read ~/.tx-ide/user-agents/COMMON.md, ~/.tx-ide/user-agents/COMMON.local.md, ~/.tx-ide/user-agents/TX-ASSISTANT.md, and ~/.tx-ide/user-agents/TX-ASSISTANT.local.md (any user-agents/X.md replaces the shipped one; any user-agents/X.local.md extends it). Follow all of these for the duration of this session.'

repo=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")

build_envelope() {
  [ -z "${TMUX:-}" ] && return 0

  # run-shell does not set $TMUX_PANE — fall back to the firing client's pane.
  local target_pane="${TMUX_PANE:-}"
  [ -z "$target_pane" ] && target_pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
  [ -z "$target_pane" ] && return 0

  # S6: the envelope is now built by the Python package's unified attachment join (M-focus,
  # attachment-topology §6) — this replaces the old inline client_tty→session awk and the v1
  # store's kind/tag lookups. Call this checkout's tx (repo-relative) so it tracks the installed
  # code regardless of $PATH during coexistence; stdout is the <tx-command-prompt/>.
  "$repo/bin/tx" focus-envelope "$target_pane" 2>/dev/null || true
}

# The assistant is a PROCESS, so its tmux session is named by its id (Session.tmux_name), not by
# `tx-assistant` — resolve the live tmux target (the id) through tx rather than targeting the human
# name. Sets the globals `state` (existed|created) and `target` (the tmux id, "" if unresolved).
ensure_session() {
  target=$("$repo/bin/tx" _tmux-name "$session" 2>/dev/null)
  if [ -n "$target" ]; then
    state=existed
    return
  fi
  local claude_cmd="claude --model opus --effort medium --dangerously-skip-permissions"
  # Register through the new python tx: `tx spawn` creates the detached session, mints the uuid,
  # sets @tx_id + TX_SESSION_ID + the truecolor env, writes the v2 record, and logs once (replaces
  # the old manual `tmux new-session` + v1 record registration). Role is inferred from the command
  # (claude → llm); parent is the firing session. Call this checkout's tx so it tracks the
  # installed code regardless of $PATH.
  "$repo/bin/tx" spawn "$session" --tag tx-system --cwd "$repo" --cmd "$claude_cmd" >/dev/null
  target=$("$repo/bin/tx" _tmux-name "$session" 2>/dev/null)
  # Wait for claude's input box to render. Match the bare prompt glyph `❯` (U+276F): claude renders
  # it followed by a NON-BREAK space (U+00A0), so the old `'❯ '` (glyph + ASCII space) never matched
  # and this loop always ran the full ~10 s before send-keys fired blind.
  for _ in $(seq 1 20); do
    tmux capture-pane -p -t "$target" 2>/dev/null | grep -q '❯' && break
    sleep 0.5
  done
  state=created
}

state=""
target=""
ensure_session
if [ -z "$target" ]; then
  printf 'tx-assistant: could not resolve the assistant session\n' >&2
  exit 1
fi

if [ "$warm_only" -eq 1 ]; then
  if [ "$state" = created ]; then
    tmux send-keys -t "$target" -l -- "$priming"
    sleep 0.3
    tmux send-keys -t "$target" Enter
  fi
  exit 0
fi

envelope=$(build_envelope)
[ -n "$envelope" ] && input="$envelope $input"

if [ "$state" = created ]; then
  input="$priming Now: $input"
fi

tmux send-keys -t "$target" -l -- "$input"
sleep 0.3
tmux send-keys -t "$target" Enter
exit 0
