#!/usr/bin/env bash
# Directional pane navigation that bubbles OUT of nested sessions:
#   tmux-nav {L|D|U|R} [pane_id] [client_tty]
# At a session's edge, hop to the pane hosting this session's client (tx nests via
# `TMUX= tmux attach` on the same server) and retry there; stop at the top level.
# Both callers are edge-only: the tx-ide nav bind (passes #{client_tty}, pinning the
# first hop) and nvim's config/tmux-nav.lua (no client_tty; resolves via client list).
# The client_tty↔pane_tty join is the inverse of tmux-pane-session-name's; keep every
# mirror in lockstep with lib/tx/tmux.py `Tmux._attachment_join`.
set -u

direction="${1:-}"
pane="${2:-${TMUX_PANE:-}}"
client_tty="${3:-}"

case "$direction" in
  L) edge_format='#{pane_at_left}' ;;
  D) edge_format='#{pane_at_bottom}' ;;
  U) edge_format='#{pane_at_top}' ;;
  R) edge_format='#{pane_at_right}' ;;
  *)
    echo "usage: tmux-nav {L|D|U|R} [pane_id] [client_tty]" >&2
    exit 2
    ;;
esac

[[ -z "$pane" ]] && exit 0

# One toggle guard covers both callers; when off, nvim's maps degrade to plain wincmd.
[[ "$(tmux show-option -gqv @tx-ide-nav-keys 2>/dev/null)" == off ]] && exit 0

# Pane hosting a client of `session_id`; empty at the top level. Only DISPLAYED panes
# qualify — active + current window + attached session (the active flags alone are
# layout state, still 1 when detached): every link of the delivery chain was displayed
# at press time, so this picks the chain the key traveled, not tmux listing order.
# A session displayed through two live chains at once resolves to the first match.
host_pane_of() {
  local session_id="$1" ttys
  ttys=$(tmux list-clients -t "$session_id" -F '#{client_tty}' 2>/dev/null | tr '\n' ' ')
  [[ -z "$ttys" ]] && return 0
  tmux list-panes -a \
    -F '#{pane_tty} #{pane_id} #{pane_active} #{window_active} #{session_attached}' 2>/dev/null |
    awk -v ttys="$ttys" '
      BEGIN { n = split(ttys, list, " "); for (i = 1; i <= n; i++) wanted[list[i]] = 1 }
      ($1 in wanted) && $3 == 1 && $4 == 1 && $5 >= 1 { print $2; exit }'
}

# Depth cap only guards a pathological attach cycle; real nests are 2-3 levels.
for _ in 1 2 3 4 5 6 7 8; do
  at_edge=$(tmux display-message -p -t "$pane" "$edge_format" 2>/dev/null) || exit 0
  if [[ "$at_edge" != 1 ]]; then
    tmux select-pane "-$direction" -t "$pane" 2>/dev/null
    exit 0
  fi
  if [[ -n "$client_tty" ]]; then
    host=$(tmux list-panes -a -F '#{pane_tty} #{pane_id}' 2>/dev/null |
      awk -v tty="$client_tty" '$1 == tty { print $2; exit }')
    client_tty=""
  else
    session_id=$(tmux display-message -p -t "$pane" '#{session_id}' 2>/dev/null) || exit 0
    host=$(host_pane_of "$session_id")
  fi
  [[ -z "$host" ]] && exit 0
  pane="$host"
done
exit 0
