#!/usr/bin/env bash
# prefix+e: edit the tx session visible in the firing pane, in a popup on the firing client.
set -eu

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
pane_id="$1"
client_name="$2"

# run-shell expands pane/client formats before the popup starts. display-popup's
# shell-command does not expand them, so pass the captured pane and client as literal arguments.
# Centred on the client screen like prefix+f; the form needs 7 rows. The popup closes when the
# editor exits — the outcome is reported on the status line.
printf -v edit_command '%q _edit-session %q %q' "$SCRIPT_DIR/tx" "$pane_id" "$client_name"
exec tmux display-popup -c "$client_name" -E -w 80 -h 9 -x C -y C -b heavy \
  -S "fg=yellow,bold" \
  -T ' Edit session ' "$edit_command"
