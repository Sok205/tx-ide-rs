#!/usr/bin/env bash
# prefix+f: fork the tx session visible in the firing pane, naming it in a popup on the firing client.
set -eu

TX="$(tmux show-option -gv @tx-bin) --state-dir $(tmux show-option -gv @tx-state)"
pane_id="$1"
client_name="$2"

# run-shell expands pane/client formats before the popup starts. display-popup's
# shell-command does not expand them, so pass the captured pane and client as literal arguments.
# Centred on the client screen, not over the firing pane.
printf -v fork_command '%s _fork-pane %q %q' "$TX" "$pane_id" "$client_name"
exec tmux display-popup -c "$client_name" -E -w 80 -h 4 -x C -y C -b heavy \
  -S "fg=yellow,bold" \
  -T ' Fork session ' "$fork_command"
