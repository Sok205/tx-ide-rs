#!/usr/bin/env bash
# prefix+X: confirm, then `tx kill` the session in the active pane, tmux-native style.
# Mirrors the stock prefix+x / prefix+& UX (a `confirm-before` status-line prompt). Agents and
# views end the same way: `tx kill` kills the tmux session, and for an agent marks its record
# ended first — never a raw `kill-session` that would leave the store stale (COMMON.md).
#
# Target: the session attached INSIDE the pane when it hosts a nested `tmux attach`
# (the same pane→client join the border label uses), else the outer session itself
# (a direct foreground attach). The home base is refused.
#
# The prompt shows the store-owned DISPLAY name (a PROCESS is tmux-named by its id);
# the kill targets the tmux name, which `tx kill` resolves either way.
set -eu

TX="$(tmux show-option -gv @tx-bin) $(tmux show-option -gv @tx-arguments)"

pane_id="${1:-}"
outer="${2:-}"
[[ -z "$pane_id" || -z "$outer" ]] && exit 0

# The pane's tty is the nested client's tty.
pane_tty=$(tmux display-message -p -t "$pane_id" '#{pane_tty}' 2>/dev/null) || exit 0
inner=$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null |
  awk -v t="$pane_tty" '$1==t {print $2; exit}')

target="${inner:-$outer}"

if [[ "$(tmux show-options -vqt "$target" @tx-view-kind 2>/dev/null)" == home ]]; then
  tmux display-message "tx: '$target' is the home base, not a tx session — nothing to kill here"
  exit 0
fi

# Display name from the record (@tx-id → `_pane-info` line 1); the raw tmux name for a view,
# or when `_pane-info` is unavailable (the `labels` plugin is off) or prints nothing.
name="$target"
tx_id=$(tmux show-options -vqt "$target" @tx-id 2>/dev/null) || tx_id=""
if [[ -n "$tx_id" ]]; then
  resolved=""
  # shellcheck disable=SC2086 # TX is a command plus its directory flags
  IFS= read -r resolved < <($TX _pane-info "$tx_id" 2>/dev/null) || true
  if [[ -n "$resolved" ]]; then
    name="$resolved"
  fi
fi

# Silence successful kills, keep errors visible, and treat `n` as cancellation.
tmux confirm-before -p "kill \"$name\"? (y/n)" \
  "run-shell \"$TX kill '$target' 2>&1 >/dev/null\"" || true
