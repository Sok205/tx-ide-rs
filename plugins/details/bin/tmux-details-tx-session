#!/usr/bin/env bash
# prefix+i: the details of the tx session visible in the firing pane, in a popup over that pane.
set -eu

TX="$(tmux show-option -gv @tx-bin) $(tmux show-option -gv @tx-arguments)"
pane_id="$1"
client_name="$2"
pane_width=$(tmux display-message -p -t "$pane_id" '#{pane_width}')
pane_height=$(tmux display-message -p -t "$pane_id" '#{pane_height}')
popup_width=$((pane_width - 4))
((popup_width > 100)) && popup_width=100
((popup_width < 60)) && popup_width=60
popup_height=$((pane_height - 2))
((popup_height > 44)) && popup_height=44
((popup_height < 12)) && popup_height=12

# run-shell expands pane/client formats before the popup starts. display-popup's
# shell-command does not expand them, so pass the captured pane and client as literal arguments.
# Placed over the firing pane; the popup closes when the viewer exits (q / Esc) — a failure is
# reported on the status line.
printf -v details_command '%s _details-popup %q %q' "$TX" "$pane_id" "$client_name"
exec tmux display-popup -c "$client_name" -t "$pane_id" -E -w "$popup_width" -h "$popup_height" \
  -x '#{e|+:#{popup_pane_left},#{e|/:#{e|-:#{pane_width},#{popup_width}},2}}' \
  -y '#{e|+:#{popup_pane_top},1}' -b heavy \
  -S "fg=blue,bold" \
  -T ' Details ' "$details_command"
